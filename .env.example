# Copy with: powershell -ExecutionPolicy Bypass -File scripts/init-env.ps1
# Values beginning with CHANGE_ME are placeholders, never real credentials.

APP_ENV=development
LOG_LEVEL=INFO
CONTROL_API_PORT=8080
CONTROL_API_TOKEN=CHANGE_ME_CONTROL_API_TOKEN
# Comma-separated Host header allowlist. Keep the private VPS deployment on
# loopback; add a DNS name only after the public OIDC/TLS gate exists.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Browser sessions use the machine token only as an HMAC root key. Keep Secure
# false for loopback HTTP/SSH tunnels; set true only behind verified HTTPS.
DASHBOARD_SESSION_TTL_SECONDS=43200
DASHBOARD_COOKIE_SECURE=false
# VPS service startup reads this explicit action-worker switch. Leave false
# until TLS SMTP and an owned-inbox canary have passed.
VPS_SIDE_EFFECTS_ENABLED=false

POSTGRES_DB=agent
POSTGRES_USER=agent_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

TASK_QUEUE_KEY=agent:tasks:ready
JOB_QUEUE_KEY=agent:jobs:ready
ACTION_QUEUE_KEY=agent:actions:ready
WORKER_POLL_SECONDS=5
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=10
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
CAREER_SCHEDULER_SECONDS=30

# Optional creator discovery. Restrict this key to YouTube Data API v3 and the
# deployment source IP. It is passed only to the egress-enabled research worker.
YOUTUBE_API_KEY=

# Managed upstream agent profile. The dashboard launcher enables it automatically.
OMNIROUTE_PORT=20128
OMNIROUTE_INITIAL_PASSWORD=CHANGE_ME_OMNIROUTE_INITIAL_PASSWORD
OMNIROUTE_API_KEY_SECRET=CHANGE_ME_OMNIROUTE_API_KEY_SECRET
OMNIROUTE_JWT_SECRET=CHANGE_ME_OMNIROUTE_JWT_SECRET
OMNIROUTE_MACHINE_ID_SALT=CHANGE_ME_OMNIROUTE_MACHINE_ID_SALT
# Created from OmniRoute dashboard after first boot. Not auto-generated here.
OMNIROUTE_API_KEY=CHANGE_ME_AFTER_OMNIROUTE_ONBOARDING

# Optional fully local inference profile. qwen3:8b is a 5.2 GB Q4 model.
LOCAL_MODEL=qwen3:8b
LOCAL_MODEL_CONTEXT_LENGTH=8192
# Ollama loads Qwen on the first fallback call and unloads it after this idle time.
LOCAL_MODEL_KEEP_ALIVE=5m

# Optional zero-cost hosted fallback. Hermes receives this key for its secondary
# openrouter/free route; the career worker also enforces exact :free catalog and
# returned-cost checks before it uses the account.
# OPENROUTER_ENABLED controls career drafting only; Hermes uses a configured key
# for its managed second route regardless of this toggle.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
# Empty uses live benchmark/capability ranking; comma-separated overrides must
# contain only exact :free model IDs. OpenRouter permits one primary plus three
# fallback entries per request, so values above 4 are safely capped at 4.
OPENROUTER_MODEL_PRIORITY=
OPENROUTER_MAX_MODELS=4
# Leave at 50 unless the account has purchased at least USD 10 of credits in
# total; then set 1000. Runtime preserves headroom by reserving only 40/900.
OPENROUTER_FREE_DAILY_ALLOWANCE=50
OPENROUTER_DAILY_REQUEST_CAP=900
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
OPENROUTER_LOCAL_FALLBACK=true

# Optional side-effect worker. Keep disabled until you intentionally configure it.
MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=
SMTP_TLS_MODE=starttls
# External SMTP only: durable low-volume pacing. Mailpit tests stay immediate.
OUTBOUND_EMAIL_MIN_INTERVAL_SECONDS=900
OUTBOUND_EMAIL_DOMAIN_MIN_INTERVAL_SECONDS=1800
OUTBOUND_EMAIL_HOURLY_LIMIT=3
OUTBOUND_EMAIL_DAILY_LIMIT=12
OUTBOUND_EMAIL_JITTER_SECONDS=180
MAILPIT_UI_PORT=8025

# Gmail reply tracking: read-only OAuth, one operator-created career label.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_CAREER_LABEL=Hermes/Careers
