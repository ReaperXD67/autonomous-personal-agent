# Copy with: powershell -ExecutionPolicy Bypass -File scripts/init-env.ps1
# Values beginning with CHANGE_ME are placeholders, never real credentials.

APP_ENV=development
LOG_LEVEL=INFO
CONTROL_API_PORT=8080
CONTROL_API_TOKEN=CHANGE_ME_CONTROL_API_TOKEN

POSTGRES_DB=agent
POSTGRES_USER=agent_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

TASK_QUEUE_KEY=agent:tasks:ready
JOB_QUEUE_KEY=agent:jobs:ready
ACTION_QUEUE_KEY=agent:actions:ready
WORKER_POLL_SECONDS=5
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=10
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
CAREER_SCHEDULER_SECONDS=30

# Optional creator discovery. Restrict this key to YouTube Data API v3 and the
# deployment source IP. It is passed only to the egress-enabled research worker.
YOUTUBE_API_KEY=

# Optional upstream agent profile: docker compose --profile agent up -d
OMNIROUTE_PORT=20128
OMNIROUTE_INITIAL_PASSWORD=CHANGE_ME_OMNIROUTE_INITIAL_PASSWORD
OMNIROUTE_API_KEY_SECRET=CHANGE_ME_OMNIROUTE_API_KEY_SECRET
OMNIROUTE_JWT_SECRET=CHANGE_ME_OMNIROUTE_JWT_SECRET
OMNIROUTE_MACHINE_ID_SALT=CHANGE_ME_OMNIROUTE_MACHINE_ID_SALT
# Created from OmniRoute dashboard after first boot. Not auto-generated here.
OMNIROUTE_API_KEY=CHANGE_ME_AFTER_OMNIROUTE_ONBOARDING

# Optional fully local inference profile. qwen3:8b is a 5.2 GB Q4 model.
LOCAL_MODEL=qwen3:8b
LOCAL_MODEL_CONTEXT_LENGTH=8192

# Optional zero-cost hosted drafting. The egress-enabled job worker is the only
# application service that receives this key. Every catalog candidate must use
# a :free slug and attest zero prompt/completion/request cost before it is used.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
# Empty uses the reviewed live-ranked defaults; comma-separated overrides must
# contain only exact :free model IDs.
OPENROUTER_MODEL_PRIORITY=
OPENROUTER_MAX_MODELS=8
# Leave at 50 unless the account has purchased at least USD 10 of credits in
# total; then set 1000. Runtime preserves headroom by reserving only 40/900.
OPENROUTER_FREE_DAILY_ALLOWANCE=50
OPENROUTER_DAILY_REQUEST_CAP=900
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=true
OPENROUTER_LOCAL_FALLBACK=true

# Optional side-effect worker. Keep disabled until you intentionally configure it.
MAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=
SMTP_TLS_MODE=starttls
MAILPIT_UI_PORT=8025
